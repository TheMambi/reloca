# Reloca — Environment Variables Template
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. Never commit real keys.
#
# Conventions:
#   NEXT_PUBLIC_*  → built into the pages sent to every browser. Never put a
#                    key that opens the database behind this prefix.
#   no prefix      → stays on the server

# =====================================================
# Mode  (required: the app refuses to build or serve without it)
# =====================================================

# What the app runs on. There is no default.
#   demo     fictional sample data held in memory. Needs nothing else in this file.
#   private  your own Supabase database. Needs the three Supabase values below
#            and RELOCA_ACCESS_GATE.
# A missing or mistyped value stops the app. It never falls back to the database.
# The older RELOCA_DEMO_MODE=1 still selects the demo.
RELOCA_MODE=

# Private mode only. The app has no sign-in of its own, so anyone who can open
# its address can read and change your data. Something outside the app has to
# keep strangers out. Name it here, for example:
#   vercel-authentication  Vercel's Deployment Protection covers every address
#                          of the project, the production domain included
#   local-only             this copy only ever runs on your own computer
# The app cannot check the gate for you. It refuses to run in private mode
# until one is named, so a private copy cannot go live with nothing in front
# of it by accident.
RELOCA_ACCESS_GATE=

# =====================================================
# Supabase  (all app data in private mode; not needed when RELOCA_MODE=demo)
# =====================================================

# Only the server talks to the database. The anon key is not used: since
# migration 0025 the database refuses it, so do not add it here.
# See docs/security-lockdown.md.

# Project URL. Not a secret. The older name NEXT_PUBLIC_SUPABASE_URL is still
# read when this one is empty.
SUPABASE_URL=

# Service role key. A SECRET: it reads and writes every row and skips row level
# security. Every database request the server makes uses it. Keep it on the
# server, never give it a NEXT_PUBLIC_ name, never paste it into a chat, a log
# or a screenshot. If it leaks, replace it in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# The id stored in the user_id column of every row. The server adds it to every
# query. It is an identifier, not a secret: knowing it opens nothing.
# Generate once with: `node -e "console.log(crypto.randomUUID())"` and keep it.
RELOCA_SINGLE_USER_ID=

# =====================================================
# Move metadata  (drives dashboard countdown + checklist due-date computation)
# =====================================================

# Target move date — ISO format YYYY-MM-DD.
# FALLBACK ONLY since Phase 8: the live source of truth is the active row in
# the `relocations` table (editable via the top-strip countdown, which now
# persists to the DB). This env var is read only when no relocation has been
# seeded yet. Keep it matching the seeded active move to avoid a split-brain.
NEXT_PUBLIC_MOVE_DATE=2026-09-30

# Origin and destination cities — drive header + dashboard hero text
NEXT_PUBLIC_ORIGIN_CITY=Denver, CO
NEXT_PUBLIC_DEST_CITY=Long Beach, CA

# =====================================================
# Runtime API keys (read on each request — MUST be set in Vercel)
# =====================================================

# HUD User API key — fair-market-rent overlays for destinations, read at
# request time by lib/lease/hud.ts. This is the ONLY external API key the
# deployed app reads at runtime, so it's the only one that needs to live in
# the Vercel project settings. Free; sign up at
# https://www.huduser.gov/portal/dataset/fmr-api.html.
# Server-only. Never expose with NEXT_PUBLIC_.
HUD_FMR_API_KEY=

# =====================================================
# Ingestion-only API keys (local `scripts/ingest-city.ts` only)
# =====================================================
# These are read ONLY by the local city-data ingestion script
# (scripts/lib/fetchers.ts), which writes committed JSON snapshots under
# data/. The deployed app reads that committed JSON, never these APIs live —
# so DO NOT add these to Vercel. Run ingestion with:
#   pnpm tsx --env-file=.env.local scripts/ingest-city.ts <slug|all>
# (If air quality ever becomes a live runtime fetch instead of ingested JSON,
#  AIRNOW_API_KEY would then need to move to Vercel — not today.)

# NOAA Climate Data Online token — climate normals (temps, precip, heat days).
# Free; request at https://www.ncdc.noaa.gov/cdo-web/token. Server-only.
NOAA_CDO_TOKEN=

# U.S. Census API key — OPTIONAL. ACS pulls work keyless up to 500 req/day per
# IP (our batch is a few calls); a key only raises that ceiling. Server-only.
CENSUS_API_KEY=

# EPA AirNow API key — current air-quality observations during ingestion.
# Free; request at https://docs.airnowapi.org/account/request/. Server-only.
AIRNOW_API_KEY=

# Walk Score API key — DEFERRED to v2 per AD-018. The free-tier signup
# rejects emails whose domain doesn't match the "domain where Walk Score
# will be used" field, which makes it friction-heavy for personal projects.
# `lib/lease/overlays.ts` no-ops the walk_score / transit_score / bike_score
# columns; if the user later registers, drop the key in here and the
# orchestrator will start populating them without code changes.
# WALKSCORE_API_KEY=

# =====================================================
# Reserved for v2 (do not set in v1)
# =====================================================

# Mapbox token — for property-search map view
# MAPBOX_TOKEN=

# Resend / SendGrid API key — for email reminder feature
# RESEND_API_KEY=

# Auth provider keys, for when v2 adds Supabase Auth and per-user policies

# CARTO basemap tiles (free key: https://carto.com/basemaps/apikey). Public by design:
# it is sent to the browser, so restrict it to your hosts in CARTO's dashboard.
NEXT_PUBLIC_CARTO_API_KEY=
